PUBLIC_BASE_URL=https://remote-control.re

# Use a unique, high-entropy value. Generate it with: openssl rand -hex 32
REGISTER_API_TOKEN=replace-with-a-long-random-secret

# Comma-separated upstream domain suffixes allowed by the proxy.
ALLOWED_HOST_SUFFIXES=cloud.gcore.com,ipmi.ovh.net

SESSION_TTL_SECONDS=3000
PREFETCH_PROVIDER_COOKIES=true